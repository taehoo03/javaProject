<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mwodeun.CartMapper">

    <resultMap id="cartResultMap" type="com.mwodeun.CartVO">
        <id property="cartId" column="CART_ID"/>
        <result property="memberId" column="MEMBER_ID"/>
        <result property="productId" column="PRODUCT_ID"/>
        <result property="quantity" column="QUANTITY"/>
    </resultMap>

    <select id="getCart"
            parameterType="int"
            resultMap="cartResultMap">
        SELECT
            CART_ID,
            MEMBER_ID,
            PRODUCT_ID,
            QUANTITY
        FROM CART
        WHERE MEMBER_ID = #{memberId}
        ORDER BY CART_ID
    </select>

    <insert id="insertCart"
            parameterType="com.mwodeun.CartVO">
        INSERT INTO CART (
            MEMBER_ID,
            PRODUCT_ID,
            QUANTITY
        )
        VALUES (
            #{memberId},
            #{productId},
            #{quantity}
        )
    </insert>

    <update id="updateCart"
            parameterType="com.mwodeun.CartVO">
        UPDATE CART
        SET
            QUANTITY = #{quantity}
        WHERE CART_ID = #{cartId}
    </update>

    <delete id="deleteCart"
            parameterType="int">
        DELETE FROM CART
        WHERE CART_ID = #{cartId}
    </delete>

</mapper>