<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mwodeun.ProductMapper">

    <resultMap id="productResultMap" type="com.mwodeun.ProductVO">
        <id property="productId" column="PRODUCT_ID"/>
        <result property="category" column="CATEGORY"/>
        <result property="productName" column="PRODUCT_NAME"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="price" column="PRICE"/>
        <result property="stock" column="STOCK"/>
    </resultMap>

    <select id="getProducts" resultMap="productResultMap">
        SELECT
            PRODUCT_ID,
            CATEGORY,
            PRODUCT_NAME,
            DESCRIPTION,
            PRICE,
            STOCK
        FROM PRODUCT
        ORDER BY PRODUCT_ID
    </select>

    <insert id="insertProduct" parameterType="com.mwodeun.ProductVO">
        INSERT INTO PRODUCT (
            CATEGORY,
            PRODUCT_NAME,
            PRICE,
            STOCK
        )
        VALUES (
            #{category},
            #{productName},
            #{price},
            #{stock}
        )
    </insert>

    <update id="updateProduct" parameterType="com.mwodeun.ProductVO">
        UPDATE PRODUCT
        SET
            CATEGORY = #{category},
            PRODUCT_NAME = #{productName},
            PRICE = #{price},
            STOCK = #{stock}
        WHERE PRODUCT_ID = #{productId}
    </update>

    <delete id="deleteProduct">
        DELETE FROM PRODUCT
        WHERE PRODUCT_ID = #{productId}
    </delete>

</mapper>